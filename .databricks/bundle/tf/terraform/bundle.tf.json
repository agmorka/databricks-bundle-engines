{
  "terraform": {
    "required_providers": {
      "databricks": {
        "source": "databricks/databricks",
        "version": "1.117.0"
      }
    }
  },
  "provider": {
    "databricks": {}
  },
  "resource": {
    "databricks_job": {
      "my_job": {
        "deployment": {
          "kind": "BUNDLE",
          "metadata_file_path": "/Workspace/Users/<your-email>/.bundle/my-bundle/tf/state/metadata.json"
        },
        "edit_mode": "UI_LOCKED",
        "environment": [
          {
            "environment_key": "default",
            "spec": {
              "dependencies": [
                "/Workspace/Users/<your-email>/.bundle/my-bundle/tf/artifacts/.internal/my_module-0.1.0-py2.py3-none-any.whl"
              ],
              "environment_version": "2"
            }
          }
        ],
        "format": "MULTI_TASK",
        "max_concurrent_runs": 4,
        "name": "[tf <your-user>] my_job",
        "queue": {
          "enabled": true
        },
        "tags": {
          "dev": "<your-user>"
        },
        "task": [
          {
            "environment_key": "default",
            "python_wheel_task": {
              "entry_point": "hello",
              "package_name": "my_module"
            },
            "retry_on_timeout": true,
            "task_key": "hello"
          }
        ]
      }
    }
  }
}
